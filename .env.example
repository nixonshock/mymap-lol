# mymap.lol env vars (placeholders only — NEVER put real values here)
# Copy to .env.local locally and set them in Vercel → Project Settings.

# demo (default) simulates payment so the whole funnel works offline.
# live = charge real money. You must also wire the provider call in src/lib/checkout.ts
#   and set NEXT_PUBLIC_PAYMENT_PROVIDER plus the matching provider keys.
NEXT_PUBLIC_PAYMENT_MODE=demo

# whop | lnbits | stripe  (choose one when NEXT_PUBLIC_PAYMENT_MODE=live)
NEXT_PUBLIC_PAYMENT_PROVIDER=

# --- Bitcoin Lightning (LNbits) example ---
# LN_BITS_URL=https://your-lnbits-host
# LN_BITS_ADMIN_KEY=  (invoices + webhook creds)

# --- Shared leaderboard (Supabase) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  (server-only: create server route that uses this)
