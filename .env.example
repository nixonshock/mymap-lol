# mymap.lol env vars (placeholders only — NEVER put real values here)
# Copy to .env.local locally and set them in Vercel → Project Settings → Environment Variables.

# ------------------------------------------------------------------ payments
# demo (default) simulates payment so the whole funnel works with no keys.
# live = charge real money (Phase 2: also wire the provider + webhook in src/lib/checkout.ts
#        and src/app/api/payments/webhook — until then live mode refuses to take money).
NEXT_PUBLIC_PAYMENT_MODE=demo

# stripe | lnbits | whop   (used when NEXT_PUBLIC_PAYMENT_MODE=live)
NEXT_PUBLIC_PAYMENT_PROVIDER=

# --- Stripe (recommended rail; 3% + RM1.00 on cards/FPX in Malaysia) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Bitcoin Lightning (LNbits) alternative ---
# LNBITS_URL=
# LNBITS_ADMIN_KEY=   (invoices + webhook creds)

# --- Whop (what worldmap.lol uses; hosted checkout + signed webhook) ---
# WHOP_API_KEY=
# WHOP_COMPANY_ID=biz_
# WHOP_PRODUCT_ID=prod_
# Plan currency. Keep usd: the card is charged US dollars and the "≈ RM…" the
# site shows is a display conversion (NEXT_PUBLIC_USD_MYR), not a charge.
# WHOP_CURRENCY=usd
# WHOP_ADAPTIVE_PRICING=false
# WHOP_WEBHOOK_SECRET=ws_
# WHOP_SANDBOX=true
# WHOP_SUPPORT_EMAIL=

# --------------------------------------------------- shared board (Supabase)
# Server-only. The service-role key bypasses row level security: never prefix
# it with NEXT_PUBLIC_ and never commit it. Without these two the app stays in
# demo mode (browser-local board) and /api/board answers {mode:"demo"}.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt used when hashing visitor IPs for the stake rate-limit table (never stores raw IPs).
IP_SALT=

# --------------------------------------------------------------- pricing display
# Billing is USD; every price is also shown in ringgit at this rate.
# Update when the rate moves (or wire a FX feed later).
NEXT_PUBLIC_USD_MYR=4.04
